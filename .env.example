# === Обязательно ===
BOT_TOKEN=123456:ABC-DEF            # @BotFather
OWNER_IDS=                           # ваш числовой Telegram id через запятую (узнать: @userinfobot); пусто = бот напишет в логи одноразовый код, отправьте ему /start КОД

# === Что продаёте (идёт в промпт ИИ; можно менять командой /profile) ===
PROFILE=Студия делает: сайты и лендинги под ключ, Telegram-боты, ИИ-автоматизацию бизнеса (чат-боты, интеграции, CRM, n8n), ИИ-мультики и видеоролики. Работаем удалённо по всей России и СНГ.

# Фразы-намерения для Threads, VK и поисковиков (через запятую). Меняются в боте: /phrases_set, /phrases_gen
# SEARCH_PHRASES=нужен сайт,ищу кто сделает сайт,нужен telegram бот,ищу разработчика бота,нужна автоматизация

# === «Как человек»: источники без API ===
PROXY_URL=                           # http://user:pass@host:port — резидентный/мобильный прокси; пусто = без прокси
WORK_HOURS=8-23                      # парсим только днём по DIGEST_TZ
THREADS_WEB_ENABLED=true             # поиск Threads без логина
KWORK_ENABLED=true
KWORK_CATEGORIES=11                  # 11 = Разработка и IT; добавьте ,all для всех категорий (много мусора)
KWORK_PAGES=3
WEBLANCER_ENABLED=true
FREELANCE_RU_ENABLED=true
FREELANCE_RU_QUERIES=сайт,лендинг,бот,автоматизация,нейросеть,мультик
YANDEX_WEB_ENABLED=true              # Яндекс.Карты без ключа (если задан YANDEX_GEOSEARCH_KEY — через API)
SITE_AUDIT_ENABLED=true              # проверять сайты организаций: мёртвый / без HTTPS / не мобильный → лид на редизайн
SITE_AUDIT_PER_POLL=30

# Instagram через залогиненный браузер: python -m leadhunter.browser.login instagram, затем включить
IG_WEB_ENABLED=false
IG_WEB_PER_POLL=3
BROWSER_PROFILES_DIR=data/profiles
BROWSER_HEADLESS=true

# === Telegram-чаты (через ваш аккаунт, my.telegram.org -> API development tools) ===
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/userbot
TG_CHATS=                            # @chat1,@chat2 — пусто = все группы, где состоит аккаунт
TG_JOIN_CHATS=                       # @chat или ссылки t.me/+xxx — вступить при старте
TG_SEARCH_INTERVAL=600
TG_OUTREACH_LIMIT=0                  # кнопка «Отправить с аккаунта»: сообщений в день (0 = выключено). 10-20 безопасно

# === Вебхук для CRM / n8n / Make / Google Sheets: POST JSON с каждым лидом ===
WEBHOOK_URL=

# === Рабочая группа (форум с темами) и команда ===
# Создайте группу → включите «Темы» → добавьте бота админом с правом «Управление темами» → напишите в ней /setup_group
HOT_SCORE=8                          # с этого балла лид идёт в «🔥 Горячие» со звуком
DELIVER_DM=false                     # дублировать лидов владельцу в личку, даже если есть группа
SLA_MINUTES=10                       # лид не взят столько минут → пинг в «Горячие»
SLA_MIN_SCORE=7                      # SLA считаем для лидов с таким баллом и выше
FOLLOWUP_HOURS=24                    # напомнить, если после «Написал» клиент молчит
SPAM_CHATS_PER_HOUR=3                # автор в стольких чатах за час = рассылка, в игнор
DISCOVER_JOIN_PER_DAY=5              # /discover: сколько чатов вступать в день

# === Mini App (кабинет внутри Telegram) ===
# Вариант 1 (проще всего): MINIAPP_TUNNEL=cloudflare — бот сам поднимет бесплатный туннель Cloudflare и поставит кнопку «Кабинет».
#   Адрес меняется при каждом перезапуске, для теста и старта — идеально. cloudflared уже есть в Docker-образе.
# Вариант 2: свой домен с HTTPS (Caddy / nginx + certbot / именованный Cloudflare Tunnel) → MINIAPP_URL
MINIAPP_TUNNEL=
MINIAPP_URL=                         # https://leads.example.com/app  (пусто и без туннеля = выключено)
MINIAPP_PORT=8080

# === Официальные API (необязательно — если есть, используются вместо парсинга) ===
THREADS_ACCESS_TOKEN=                # Threads Keyword Search API (threads_keyword_search)
THREADS_INTERVAL=900
IG_ACCESS_TOKEN=                     # Instagram Graph API (бизнес-аккаунт)
IG_USER_ID=
IG_HASHTAGS=нуженсайт,ищуразработчика,нуженбот,нужнаавтоматизация,заказатьсайт,ищуподрядчика
IG_INTERVAL=1800
YANDEX_GEOSEARCH_KEY=                # Geosearch API (500 запросов/сутки)
YANDEX_CITIES=Москва,Санкт-Петербург
YANDEX_QUERIES=салон красоты,стоматология,автосервис,кофейня,фитнес клуб,ремонт квартир
YANDEX_INTERVAL=21600
VK_TOKEN=                            # user-токен VK (бесплатный)
VK_INTERVAL=300

# === Биржи и вакансии ===
RSS_FEEDS=https://www.fl.ru/rss/all.xml
RSS_INTERVAL=300
HH_ENABLED=true
HH_USER_AGENT=LeadHunter/0.1 (you@example.com)   # нужна реальная почта, иначе 403
HH_QUERIES=разработка сайта,telegram бот,автоматизация нейросеть,ИИ анимация

# === Поисковики для площадок без прямого доступа (vc.ru, pikabu) ===
SERPER_API_KEY=                      # serper.dev; пусто = DuckDuckGo без ключа
WEB_SEARCH_SITES=threads.net,instagram.com,vc.ru,pikabu.ru
WEB_SEARCH_INTERVAL=1800

# === Фильтрация ===
SCORE_THRESHOLD=5
MAX_AGE_HOURS=48
DB_PATH=data/leads.db

# === ИИ ===
# Вариант A (рекомендуется, один ключ на всё): Gemini — aistudio.google.com → Get API key.
#   Тексты (gemini-3.8-flash, есть бесплатный лимит), озвучка (gemini-3.8-flash-tts, бесплатно),
#   картинки (gemini-nano-banana-2.1 ≈ 0,03 $/шт, нужен биллинг), ИИ-видео (gemini-omni-1.2-flash ≈ 0,07 $/сек, нужен биллинг).
GEMINI_API_KEY=
GEMINI_MODEL=                        # пусто = gemini-3.5-flash-lite (щедрый бесплатный лимит); умнее: gemini-3.8-flash
GEMINI_IMAGE_MODEL=                  # пусто = gemini-nano-banana-2.1; дешевле: gemini-3.1-flash-lite-image
GEMINI_VIDEO_MODEL=                  # пусто = gemini-omni-1.2-flash
GEMINI_TTS_MODEL=                    # пусто = gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
# Вариант B: любой OpenAI-совместимый API для текстов (OpenAI, OpenRouter, DeepSeek, Ollama). Если задан — тексты идут сюда, медиа — в Gemini.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_MIN_SCORE=2
LLM_MAX_PER_HOUR=300
# Медиа через OpenAI (только если нет GEMINI_API_KEY): IMAGE_MODEL=gpt-image-2.5-flare, TTS_MODEL — старые tts-1/gpt-4o-mini-tts закрываются 06.01.2027
IMAGE_MODEL=
TTS_MODEL=
TTS_VOICE=alloy

# === Ежедневный дайджест ===
DIGEST_HOUR=9
DIGEST_TZ=Europe/Moscow

# === Контент-фабрика ===
CONTENT_DIR=data/content
CONTENT_HOUR=10                      # автопилот (/autopilot on) приносит черновик в этот час
# Площадки. Telegram-канал и VK задаются в боте: /channel_set telegram @канал, /channel_set vk -id_группы
# VK: токен сообщества публикует только текст; для фото/видео нужен пользовательский токен с правами wall,photos,video
THREADS_USER_ID=                     # публикация в Threads вместе с THREADS_ACCESS_TOKEN (права threads_content_publish)
# Instagram: IG_ACCESS_TOKEN + IG_USER_ID выше (права instagram_content_publish) + публичный адрес Mini App для картинок
YT_CLIENT_ID=                        # YouTube Shorts: OAuth-клиент Google Cloud + refresh token с правом youtube.upload
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
